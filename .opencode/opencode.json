{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "ask",
      "curl *": "deny",
      "wget *": "deny",
      "npx *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sftp *": "deny",
      "telnet *": "deny",
      "nc *": "deny",
      "ncat *": "deny",
      "rsync *": "deny",
      "ping *": "deny",
      "nslookup *": "deny",
      "* /tmp/*": "deny",
      "cd /tmp*": "deny"
    }
  }
}